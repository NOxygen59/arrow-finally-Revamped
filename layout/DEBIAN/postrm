#!/usr/bin/env bash
# Asks the package manager (Sileo, Zebra, Cydia) to offer a userspace reboot once it is done,
# as ElleKit does: pointeruid only loads the tweak (or drops it) when it starts again.

# From https://theapplewiki.com/wiki/Dev:Packaging
function finish() {
    f="${1}"

    # No control fd: bail out
    [[ -z "${f}" || -z "${CYDIA}" ]] && return
    cydia=(${CYDIA})

    # Cydia control fd version != 1: bail out
    [[ ${cydia[1]} -eq 1 ]] || return

    echo "finish:${f}" >&${cydia[0]}
}

finish usreboot
exit 0
